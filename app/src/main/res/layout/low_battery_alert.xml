<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/low_battery_alert_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/low_battery_alert_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingTop="14dp"
    android:paddingEnd="22dp"
    android:paddingBottom="14dp">

    <ImageView
        android:id="@+id/low_battery_product_artwork"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:contentDescription="@string/airpods_artwork_desc"
        android:scaleType="fitCenter"
        tools:src="@drawable/airpods" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/low_battery_device_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            tools:text="우성의 AirPods Pro" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/low_battery_percentage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="#FFF5F5F7"
                android:textSize="19sp"
                tools:text="20%" />

            <FrameLayout
                android:id="@+id/low_battery_glyph"
                android:layout_width="48dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_battery_outline" />

                <View
                    android:id="@+id/low_battery_fill"
                    android:layout_width="2dp"
                    android:layout_height="10dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="5dp"
                    android:background="#FFFF453A" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
